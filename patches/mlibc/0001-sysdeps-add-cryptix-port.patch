+
+#define STUB(signature)                                                                            \
+	signature { sys_libc_log(#signature "is a stub!"); }
+#define STUB_RET(signature)                                                                        \
+	signature {                                                                                    \
+		sys_libc_log(#signature " is a stub!");                                                    \
+		return 0;                                                                                  \
