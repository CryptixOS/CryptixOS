From 4500705e3f3250cbdd93d33ad7d14cdf2c3d173e Mon Sep 17 00:00:00 2001
From: V1tr10l7 <vitriol1744@gmail.com>
Date: Mon, 8 Sep 2025 17:10:11 +0200
Subject: [PATCH] [cryptix]: implement clone, and gettid syscalls

---
 sysdeps/cryptix/include/cryptix/syscall.h |  2 ++
 sysdeps/cryptix/sysdeps/internal.cpp      | 30 -----------------
 sysdeps/cryptix/sysdeps/process.cpp       | 40 +++++++++++++++++++++--
 sysdeps/cryptix/sysdeps/vfs.cpp           | 14 ++++----
 4 files changed, 47 insertions(+), 39 deletions(-)

diff --git a/sysdeps/cryptix/include/cryptix/syscall.h b/sysdeps/cryptix/include/cryptix/syscall.h
index a6ee0c8..634b0a3 100644
--- a/sysdeps/cryptix/include/cryptix/syscall.h
+++ b/sysdeps/cryptix/include/cryptix/syscall.h
@@ -43,6 +43,7 @@ constexpr size_t SYS_DUP2 = 33;
 constexpr size_t SYS_NANOSLEEP = 35;
 constexpr size_t SYS_GETPID = 39;
 constexpr size_t SYS_SOCKET = 41;
+constexpr size_t SYS_CLONE = 56;
 constexpr size_t SYS_FORK = 57;
 constexpr size_t SYS_EXECVE = 59;
 constexpr size_t SYS_EXIT = 60;
@@ -91,6 +92,7 @@ constexpr size_t SYS_MOUNT = 165;
 constexpr size_t SYS_UMOUNT = 166;
 constexpr size_t SYS_REBOOT = 169;
 constexpr size_t SYS_INIT_MODULE = 175;
+constexpr size_t SYS_GETTID = 186;
 constexpr size_t SYS_GETDENTS64 = 217;
 constexpr size_t SYS_CLOCK_GETTIME = 228;
 constexpr size_t SYS_PANIC = 255;
diff --git a/sysdeps/cryptix/sysdeps/internal.cpp b/sysdeps/cryptix/sysdeps/internal.cpp
index 82a03fa..03b3cbe 100644
--- a/sysdeps/cryptix/sysdeps/internal.cpp
+++ b/sysdeps/cryptix/sysdeps/internal.cpp
@@ -29,34 +29,4 @@ void sys_libc_log(const char *message) {
 
 	__builtin_unreachable();
 }
-
-STUB_RET(
-    int sys_clone(
-        [[maybe_unused]] void *tcb, [[maybe_unused]] pid_t *pid_out, [[maybe_unused]] void *stack
-    )
-);
-
-//////
-int sys_tcb_set(void *pointer) {
-	auto ret = Syscall(SYS_ARCH_PRCTL, 0x1002, pointer);
-	if (auto e = syscall_error(ret); e)
-		return e;
-
-	return ret;
-}
-
-int sys_futex_wait(int *pointer, int expected, const struct timespec *time) {
-	auto ret = Syscall(SYS_FUTEX_WAIT, pointer, expected, time);
-	if (auto e = syscall_error(ret); e)
-		return e;
-
-	return 0;
-}
-int sys_futex_wake(int *pointer) {
-	auto ret = Syscall(SYS_FUTEX_WAKE, pointer);
-	if (auto e = syscall_error(ret); e)
-		return e;
-
-	return 0;
-}
 } // namespace mlibc
diff --git a/sysdeps/cryptix/sysdeps/process.cpp b/sysdeps/cryptix/sysdeps/process.cpp
index b167bcc..0ad4aab 100644
--- a/sysdeps/cryptix/sysdeps/process.cpp
+++ b/sysdeps/cryptix/sysdeps/process.cpp
@@ -136,6 +136,16 @@ pid_t sys_getsid(pid_t pid, pid_t *out) {
 	return 0;
 }
 
+int sys_clone(void *tcb, pid_t *pid_out, void *stack) {
+	unsigned long flags = CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD
+	                      | CLONE_SYSVSEM | CLONE_SETTLS | CLONE_PARENT_SETTID;
+
+	auto ret = Syscall(SYS_CLONE, flags, stack, pid_out, NULL, tcb);
+	if (auto e = syscall_error(ret); e)
+		return e;
+
+	return 0;
+}
 int sys_fork(pid_t *child) {
 	auto ret = Syscall(SYS_FORK);
 	if (auto e = syscall_error(ret); e)
@@ -148,8 +158,34 @@ int sys_execve(const char *path, char *const argv[], char *const envp[]) {
 	return Syscall(SYS_EXECVE, path, argv, envp);
 }
 
-int sys_futex_tid() {
-	// TODO(v1tr10l7): implement sys_futex_tid
+int sys_tcb_set(void *pointer) {
+	auto ret = Syscall(SYS_ARCH_PRCTL, 0x1002, pointer);
+	if (auto e = syscall_error(ret); e)
+		return e;
+
+	return ret;
+}
+int sys_gettid() {
+	auto ret = Syscall(SYS_GETTID);
+	if (auto e = syscall_error(ret); e)
+		return e;
+
+	return 0;
+}
+int sys_futex_tid() { return sys_gettid(); }
+
+int sys_futex_wait(int *pointer, int expected, const struct timespec *time) {
+	auto ret = Syscall(SYS_FUTEX_WAIT, pointer, expected, time);
+	if (auto e = syscall_error(ret); e)
+		return e;
+
+	return 0;
+}
+int sys_futex_wake(int *pointer) {
+	auto ret = Syscall(SYS_FUTEX_WAKE, pointer);
+	if (auto e = syscall_error(ret); e)
+		return e;
+
 	return 0;
 }
 
diff --git a/sysdeps/cryptix/sysdeps/vfs.cpp b/sysdeps/cryptix/sysdeps/vfs.cpp
index cce2cfa..e4ab47f 100644
--- a/sysdeps/cryptix/sysdeps/vfs.cpp
+++ b/sysdeps/cryptix/sysdeps/vfs.cpp
@@ -421,13 +421,13 @@ int sys_tcsetattr(int fd, int optional_action, const struct termios *attr) {
 }
 STUB_RET(
     int sys_pselect(
-        int nfds,
-        fd_set *readfds,
-        fd_set *writefds,
-        fd_set *exceptfds,
-        const struct timespec *timeout,
-        const sigset_t *sigmask,
-        int *num_events
+        [[maybe_unused]] int nfds,
+        [[maybe_unused]] fd_set *readfds,
+        [[maybe_unused]] fd_set *writefds,
+        [[maybe_unused]] fd_set *exceptfds,
+        [[maybe_unused]] const struct timespec *timeout,
+        [[maybe_unused]] const sigset_t *sigmask,
+        [[maybe_unused]] int *num_events
     )
 );
 int sys_utimensat(int dirfd, const char *pathname, const struct timespec times[2], int flags) {
