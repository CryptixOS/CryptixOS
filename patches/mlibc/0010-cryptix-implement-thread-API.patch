                             | CLONE_THREAD | CLONE_SYSVSEM | CLONE_SETTLS
                             | CLONE_PARENT_SETTID;
 
-        auto ret = Syscall(SYS_CLONE, flags, stack, pid_out, nullptr, tcb);
-        if (auto e = syscall_error(ret); e) return e;
+        auto ret = __mlibc_spawn_thread(flags, stack, pid_out, nullptr, tcb);
+        if (ret < 0) return ret;
 
         return 0;
     }
+#endif
