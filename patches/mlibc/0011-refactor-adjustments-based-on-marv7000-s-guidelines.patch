 using namespace cryptix;
 
-RebootCmd cryptix_reboot_cmd(unsigned int what)
-{
-    switch (what)
-    {
-        case 0x01234567: return RebootCmd::eRestart;
-        case 0xCDEF0123: return RebootCmd::eHalt;
