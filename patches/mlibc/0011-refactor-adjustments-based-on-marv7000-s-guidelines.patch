+namespace mlibc {
+void sys_libc_log(const char *message) {
+	static constexpr char MLIBC_SIG[] = "[mlibc]: ";
+
+	size_t len = strlen(message);
+
+	long nwritten = 0;
+	sys_write(1, MLIBC_SIG, sizeof(MLIBC_SIG), &nwritten);
+	sys_write(1, message, len, &nwritten);
+	sys_write(1, "\n", 1, &nwritten);
